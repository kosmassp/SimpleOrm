{
  "name": "amend_refuses_dialect_switch",
  "comment": "Storage types are dialect-specific, so the generated root remembers its dialect. Amending a postgres-generated version under sqlite refuses, naming the dialect to use — nothing is touched.",
  "files": [
    { "path": "V0002", "generated": true, "dialect": "postgres" },
    { "path": "Table/AmendWidget/V0002_AddNote", "generated": true } ],
  "snapshots": [
    { "path": "Table/AmendWidget/V0001.schema.json", "snapshot": { "object": "amend_widgets", "asOfVersion": 1,
      "columns": [
        { "column": "id", "type": "INTEGER", "nullable": false, "key": true, "generated": true },
        { "column": "name", "type": "TEXT", "nullable": false } ],
      "indexes": [] } } ],
  "command": { "amend": true, "name": "AddRemark", "dialect": "sqlite" },
  "expect": { "exit": 1,
    "error": [ "dialect postgres" ],
    "kept": [ "V0002", "Table/AmendWidget/V0002_AddNote" ] }
}
