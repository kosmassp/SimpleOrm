{
  "name": "diff_next_version_keeps_draft",
  "comment": "Plain diff is unchanged by amend's existence: it emits the NEXT version (V0003) from the newest snapshot and leaves the V0002 draft exactly as it was.",
  "files": [
    { "path": "V0002", "generated": true, "dialect": "sqlite" },
    { "path": "Table/AmendWidget/V0002_AddNote", "generated": true } ],
  "snapshots": [
    { "path": "Table/AmendWidget/V0001.schema.json", "snapshot": { "object": "amend_widgets", "asOfVersion": 1,
      "columns": [
        { "column": "id", "type": "INTEGER", "nullable": false, "key": true, "generated": true },
        { "column": "name", "type": "TEXT", "nullable": false } ],
      "indexes": [] } } ],
  "command": { "amend": false, "name": "AddRemark" },
  "expect": { "exit": 0,
    "kept": [ "V0002", "Table/AmendWidget/V0002_AddNote" ],
    "written": [ "Table/AmendWidget/V0003_AddRemark", "V0003" ] }
}
