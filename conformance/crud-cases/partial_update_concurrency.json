{
  "name": "partial_update_concurrency",
  "steps": [
    { "op": "insert", "entity": "Transaction",
      "values": { "user_id": 1, "status": "Pending", "amount": "10", "version": 0,
                  "created_at": "2026-08-28T09:30:00.0000000Z" } },
    { "op": "get", "entity": "Transaction", "key": "$last", "as": "a" },
    { "op": "get", "entity": "Transaction", "key": "$last", "as": "b" },
    { "op": "update", "from": "a", "columns": ["amount"], "values": { "amount": "12", "note": "not written" } },
    { "op": "update", "from": "b", "columns": ["status"], "values": { "status": "Completed" },
      "expect": { "error": "CRUD-010" } },
    { "op": "get", "entity": "Transaction", "key": "$last",
      "expect": { "values": { "amount": "12", "status": "Pending", "note": null, "version": 1 } } },
    { "op": "update", "from": "a", "columns": ["version"], "values": {}, "expect": { "error": "CRUD-006" } },
    { "op": "update", "from": "a", "columns": ["status"], "values": { "status": "Completed" } },
    { "op": "get", "entity": "Transaction", "key": "$last",
      "expect": { "values": { "amount": "12", "status": "Completed", "version": 2 } } }
  ]
}
