{
  "name": "user_lifecycle",
  "steps": [
    { "op": "insert", "entity": "User",
      "values": { "name": "Ada", "email": "ada@example.com", "created_at": "2026-08-28T09:30:00.0000000Z" } },
    { "op": "get", "entity": "User", "key": "$last", "as": "a",
      "expect": { "values": { "name": "Ada", "updated_at": null } } },
    { "op": "update", "from": "a",
      "values": { "name": "Ada Lovelace", "updated_at": "2026-08-29T00:00:00.0000000Z" } },
    { "op": "get", "entity": "User", "key": "$last",
      "expect": { "values": { "name": "Ada Lovelace", "updated_at": "2026-08-29T00:00:00.0000000Z" } } },
    { "op": "delete", "entity": "User", "key": "$last" },
    { "op": "get", "entity": "User", "key": "$last", "expect": { "error": "CRUD-001" } },
    { "op": "delete", "entity": "User", "key": "$last", "expect": { "error": "CRUD-001" } }
  ]
}
