{
  "name": "derived_down_table",
  "comment": "ADR-0018 on PostgreSQL (ADR-0043): the same derived rollbacks as the SQLite case, through the dialect's renderings — renames invert from the step's pairs, adds revert to drops (the index first), the create reverts to a drop table. Snapshots carry the postgres stamp and format_type spellings. Runs on a live server (skip-gated).",
  "versions": [
    { "version": 1, "steps": [ { "object": "widgets", "description": "create",
        "up": ["create table widgets (id bigint generated by default as identity primary key, name text not null)"] } ] },
    { "version": 2, "steps": [ { "object": "widgets", "description": "add_note",
        "up": ["alter table \"widgets\" add column \"note\" text", "create index \"ix_widgets_note\" on \"widgets\" (\"note\")"] } ] },
    { "version": 3, "steps": [ { "object": "widgets", "description": "rename_name",
        "up": ["alter table \"widgets\" rename column \"name\" to \"full_name\""],
        "renames": [ { "from": "name", "to": "full_name" } ] } ] }
  ],
  "snapshots": [
    { "object": "widgets", "dialect": "postgres", "asOfVersion": 1,
      "columns": [
        { "column": "id", "type": "bigint", "nullable": false, "key": true, "generated": true },
        { "column": "name", "type": "text", "nullable": false } ],
      "indexes": [] },
    { "object": "widgets", "dialect": "postgres", "asOfVersion": 2,
      "columns": [
        { "column": "id", "type": "bigint", "nullable": false, "key": true, "generated": true },
        { "column": "name", "type": "text", "nullable": false },
        { "column": "note", "type": "text", "nullable": true } ],
      "indexes": [ { "name": "ix_widgets_note", "columns": [ { "column": "note", "direction": "asc" } ] } ] },
    { "object": "widgets", "dialect": "postgres", "asOfVersion": 3,
      "columns": [
        { "column": "full_name", "type": "text", "nullable": false },
        { "column": "id", "type": "bigint", "nullable": false, "key": true, "generated": true },
        { "column": "note", "type": "text", "nullable": true } ],
      "indexes": [ { "name": "ix_widgets_note", "columns": [ { "column": "note", "direction": "asc" } ] } ] }
  ],
  "run": [
    { "command": "migrate",
      "expect": { "applied": [[1, "widgets"], [2, "widgets"], [3, "widgets"]],
                  "columns": { "widgets": ["full_name", "id", "note"] } } },
    { "command": "down", "to": 2,
      "expect": { "applied": [[1, "widgets"], [2, "widgets"]],
                  "columns": { "widgets": ["id", "name", "note"] } } },
    { "command": "down", "to": 1,
      "expect": { "applied": [[1, "widgets"]],
                  "columns": { "widgets": ["id", "name"] } } },
    { "command": "down", "to": 0, "expect": { "applied": [] } },
    { "command": "migrate",
      "expect": { "applied": [[1, "widgets"], [2, "widgets"], [3, "widgets"]],
                  "columns": { "widgets": ["full_name", "id", "note"] } } }
  ]
}
