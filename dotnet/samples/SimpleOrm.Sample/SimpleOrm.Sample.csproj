<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleOrm.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>Sample entity models used to exercise and test the library. These become the fixture entities for the conformance suite (milestone 2).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimpleOrm\SimpleOrm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The versioned snapshots ship inside the assembly (ADR-0018): the runner
         derives migrate-down rollbacks from them, deployed or not. -->
    <EmbeddedResource Include="Migrations\**\*.schema.json" />
  </ItemGroup>


</Project>
