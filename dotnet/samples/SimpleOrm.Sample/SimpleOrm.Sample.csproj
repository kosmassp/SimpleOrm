<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleOrm.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>Sample entity models used to exercise and test the library. These become the fixture entities for the conformance suite (milestone 2).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimpleOrm\SimpleOrm.csproj" />
  </ItemGroup>

  <!-- SQL lives in .sql files as embedded resources under Sql/ (CLAUDE.md §7.5). -->
  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
  </ItemGroup>

</Project>
