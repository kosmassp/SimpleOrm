<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>SimpleOrm.Postgres</RootNamespace>
    <Description>PostgreSQL dialect for SimpleOrm (Npgsql).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleOrm\SimpleOrm.csproj" />
  </ItemGroup>

  <!-- Npgsql 9 dropped netstandard2.0; 8.x is the last line that supports it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Npgsql" Version="8.0.7" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
  </ItemGroup>

</Project>
