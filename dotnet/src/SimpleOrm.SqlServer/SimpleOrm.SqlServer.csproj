<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>SimpleOrm.SqlServer</RootNamespace>
    <Description>SQL Server dialect for SimpleOrm (Microsoft.Data.SqlClient).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleOrm\SimpleOrm.csproj" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient dropped the netstandard2.0 target after 5.x — the
       conditional references CLAUDE.md §4 anticipated for exactly this case. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.6" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- Transitive of SqlClient; pinned past the advisories NuGet audit flags on 9.0.4 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
