<Project Sdk="Microsoft.NET.Sdk">

  <!-- The CLI's isolated load context (ADR-0049) is tested against this assembly: an application
       built against a newer Microsoft.Extensions.Options than the CLI carries (9.x, through
       Microsoft.Data.SqlClient and Npgsql). A class library, like the applications the CLI is
       pointed at, so its build output holds SimpleOrm but not the package: the load context
       must find it where restore put it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NewerDependencyApp</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimpleOrm\SimpleOrm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets: the newer package must not flow into SimpleOrm.Tests, whose own
         default context has to keep the CLI's 9.x for the test to mean anything. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

</Project>
