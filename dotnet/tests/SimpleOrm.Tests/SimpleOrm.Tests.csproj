<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleOrm.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimpleOrm\SimpleOrm.csproj" />
    <ProjectReference Include="..\..\src\SimpleOrm.Sqlite\SimpleOrm.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\SimpleOrm.SqlServer\SimpleOrm.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\SimpleOrm.Postgres\SimpleOrm.Postgres.csproj" />
    <ProjectReference Include="..\..\src\SimpleOrm.Cli\SimpleOrm.Cli.csproj" />
    <ProjectReference Include="..\..\samples\SimpleOrm.Sample\SimpleOrm.Sample.csproj" />
    <!-- Built first, never referenced: the CLI's isolated load context (ADR-0049) loads it from its own
         output folder, against this project's default context, which keeps the CLI's older packages. -->
    <ProjectReference Include="..\NewerDependencyApp\NewerDependencyApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
