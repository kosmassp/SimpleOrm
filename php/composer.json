{
  "name": "simpleorm/simpleorm",
  "description": "SimpleOrm PHP port — SQL-first micro-ORM, Levels 0–1 of the SimpleOrm spec (ADR-0026).",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "ext-pdo_sqlite": "the SQLite dialect (the reference, ADR-0003)",
    "ext-pdo_pgsql": "the PostgreSQL dialect (ADR-0025)",
    "ext-pdo_sqlsrv": "the SQL Server dialect (ADR-0024); pdo_odbc with the SQL Server ODBC driver also works"
  },
  "autoload": {
    "psr-4": {
      "SimpleOrm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SimpleOrm\\Tests\\": "tests/",
      "SimpleOrm\\Sample\\": "samples/SimpleOrm.Sample/src/"
    }
  },
  "bin": [
    "bin/simpleorm"
  ],
  "scripts": {
    "test": "php -d extension=pdo_sqlite -d extension=sqlite3 vendor/bin/phpunit",
    "test-filter": "php -d extension=pdo_sqlite -d extension=sqlite3 vendor/bin/phpunit --filter",
    "test-live": "php -d extension=pdo_sqlite -d extension=sqlite3 -d extension=pdo_pgsql -d extension=pdo_odbc vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true,
    "platform-check": false
  }
}
